  "query": "\n        SELECT url, title, pub_date, source\n        FROM article_links\n        WHERE\n            ($1::text IS NULL OR url ILIKE '%' || $1 || '%')\n            AND ($2::timestamptz IS NULL OR pub_date >= $2)\n            AND ($3::timestamptz IS NULL OR pub_date <= $3)\n        ORDER BY pub_date DESC\n        ",
